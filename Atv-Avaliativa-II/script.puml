@startuml atv
left to right direction
skinparam actorStyle awesome

actor "Usuario" as usr
actor "Cliente" as cli
actor "Tecnico" as tec
actor "Gerente" as ger

' Generalização dos atores
cli --|> usr
tec --|> usr
ger --|> usr

rectangle "MS Máquinas" {

  usecase "UC01\nRealizar cadastro" as UC01
  usecase "UC02\nRealizar login" as UC02
  usecase "UC03\nVisualizar produtos" as UC03

  usecase "UC04\nAutenticar usuário" as UC04

  usecase "UC05\nSolicitar conserto" as UC05
  usecase "UC06\nComprar peças" as UC06
  usecase "UC07\nSolicitar pedido especial" as UC07
  usecase "UC08\nRealizar pagamento" as UC08
  usecase "UC09\nEmitir nota fiscal" as UC09

  usecase "UC10\nAceitar conserto" as UC10
  usecase "UC11\nVerificar estoque" as UC11

  usecase "UC12\nAtualizar status do conserto" as UC12
  usecase "UC13\nGerenciar produtos" as UC13
  usecase "UC14\nGerenciar funcionários" as UC14
  usecase "UC15\nGerar relatórios" as UC15
}

' Associações do Usuário
usr --> UC01
usr --> UC02

' Associações do Cliente
cli -up-> UC03
cli -up-> UC05
cli -up-> UC06
cli -up-> UC07
cli -up-> UC08

' Associações do Técnico
tec -up-> UC10
tec -up-> UC11
tec -up-> UC12

' Associações do Gerente
ger -up-> UC11
ger -up-> UC13
ger -up-> UC14
ger -up-> UC15

' Relações INCLUDE
UC02 .> UC04 : <<include>>
UC05 .> UC08 : <<include>>
UC06 .> UC08 : <<include>>
UC08 .> UC09 : <<include>>
UC13 .> UC11 : <<include>>

' Relações EXTEND
UC01 .> UC02 : <<extend>>
UC07 .> UC06 : <<extend>>
UC12 .> UC10 : <<extend>>

@enduml